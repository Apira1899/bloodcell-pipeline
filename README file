{"id": "e7e9151d8c36ac425432642191bbb8fd", "fileName": "neutrophil_0.png", "etag": "0x8DF47059185DE59",
 "timestamp": "2026-11-20T12:56:03.350+00:00", "day": "2026-11-20", "prediction": "monocyte", "classId": 5,
